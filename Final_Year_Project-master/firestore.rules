rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        );
    }

    // Helpers
    function isRideMember(rideId) {
      return request.auth != null && (
        // Passenger membership
        (
          get(/databases/$(database)/documents/rides/$(rideId)).data.passengers is list
          && (request.auth.uid in get(/databases/$(database)/documents/rides/$(rideId)).data.passengers)
        )
        // Accepted-by also counts as a member for group chat coordination
        || (
          get(/databases/$(database)/documents/rides/$(rideId)).data.acceptedBy is list
          && (request.auth.uid in get(/databases/$(database)/documents/rides/$(rideId)).data.acceptedBy)
        )
        // Driver or creator of shared ride
        || (get(/databases/$(database)/documents/rides/$(rideId)).data.driverId == request.auth.uid)
        || (get(/databases/$(database)/documents/rides/$(rideId)).data.createdBy == request.auth.uid)
      );
    }

    // --- Users ---
    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.status == 'pending_approval';

      allow read: if request.auth != null;

      // Admin can update anything, including status transitions
      allow update: if request.auth != null && (
        isAdmin()
        // Users can update their own profile but cannot self-approve/suspend/reject
        || (
          request.auth.uid == userId
          && request.resource.data.status == resource.data.status
          && request.resource.data.reviewedBy == resource.data.reviewedBy
          && request.resource.data.reviewedAt == resource.data.reviewedAt
          && request.resource.data.reviewAction == resource.data.reviewAction
          && request.resource.data.reviewReason == resource.data.reviewReason
        )
      );
    }

    // --- Private Verification Data ---
    match /userVerification/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // --- Invite Codes ---
    match /inviteCodes/{inviteId} {
      // Signup flow reads invite code only after auth is created
      allow read: if request.auth != null;

      // Admin creates/manages invite codes
      allow create, delete: if isAdmin();

      // Signed-in users may only consume an existing active code by incrementing usage metadata
      allow update: if request.auth != null && (
        isAdmin()
        || (
          resource.data.active == true
          && request.resource.data.codeNormalized == resource.data.codeNormalized
          && request.resource.data.block == resource.data.block
          && request.resource.data.flatNumber == resource.data.flatNumber
          && request.resource.data.registeredPhone == resource.data.registeredPhone
          && request.resource.data.maxUses == resource.data.maxUses
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.active == resource.data.active
          && request.resource.data.usedCount == resource.data.usedCount + 1
          && request.resource.data.lastUsedAt is timestamp
          && request.resource.data.lastUsedBy == request.auth.uid
          && request.resource.data.lastUsedPhoneLast4 is string
        )
      );
    }

    // --- Resident Registry ---
    match /residentRegistry/{recordId} {
      allow read, create, update, delete: if isAdmin();
    }

    // --- Approval Audit ---
    match /approvalAudit/{auditId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // --- Rides ---
    match /rides/{rideId} {
      allow read: if request.auth != null;

      // Post a ride: either driver-created or driverless shared ride by a logged-in user
      allow create: if request.auth != null && (
        // Driver-created ride
        (
          request.resource.data.driverId == request.auth.uid
          && (request.resource.data.seats is int || request.resource.data.seats is number)
          && (request.resource.data.price is int || request.resource.data.price is number)
          && request.resource.data.community is string
          && request.resource.data.destination is string
          && request.resource.data.date is string
          && request.resource.data.time is string
        )
        ||
        // Shared driverless ride: creator is auth user
        (
          request.resource.data.isShared == true
          && request.resource.data.createdBy == request.auth.uid
          && (request.resource.data.seats is int || request.resource.data.seats is number)
          && (request.resource.data.price is int || request.resource.data.price is number)
          && request.resource.data.community is string
          && request.resource.data.destination is string
          && request.resource.data.date is string
          && request.resource.data.time is string
          && request.resource.data.passengers is list
          && request.auth.uid in request.resource.data.passengers
        )
      );

      // Update rules:
      // - Driver can update their ride
      // - Passengers can join by appending to passengers
      // - Members can append to acceptedBy/completedBy
      // - Status transitions Accepted/Completed allowed when all members match
      allow update: if request.auth != null && (
        // Driver editing their ride (can change any field)
        resource.data.driverId == request.auth.uid
        ||
        // Shared ride creator editing their ride (can change any field)
        (
          resource.data.createdBy is string
          && resource.data.createdBy == request.auth.uid
        )
        ||
        // Passenger joining: append self to passengers array
        (
          request.resource.data.passengers is list
          && resource.data.passengers is list
          && request.resource.data.passengers.size() == resource.data.passengers.size() + 1
          && request.auth.uid in request.resource.data.passengers
          && !(request.auth.uid in resource.data.passengers)
          // unchanged key fields
          && request.resource.data.community == resource.data.community
          && request.resource.data.destination == resource.data.destination
          && request.resource.data.date == resource.data.date
          && request.resource.data.time == resource.data.time
          && request.resource.data.seats == resource.data.seats
          && request.resource.data.price == resource.data.price
          && request.resource.data.driverId == resource.data.driverId
        )
        ||
        // Passenger leaving: remove self from passengers array
        (
          resource.data.passengers is list
          && request.auth.uid in resource.data.passengers
          && request.resource.data.passengers is list
          && !(request.auth.uid in request.resource.data.passengers)
          && request.resource.data.passengers.size() == resource.data.passengers.size() - 1
          // key fields unchanged
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.destination == resource.data.destination
          && request.resource.data.date == resource.data.date
          && request.resource.data.time == resource.data.time
        )
        ||
        // Append acceptedBy
        (
          request.resource.data.acceptedBy is list
          && resource.data.acceptedBy is list
          && request.resource.data.acceptedBy.size() == resource.data.acceptedBy.size() + 1
          && request.auth.uid in request.resource.data.acceptedBy
          && !(request.auth.uid in resource.data.acceptedBy)
          // passengers unchanged
          && request.resource.data.passengers == resource.data.passengers
        )
        ||
        // Append completedBy
        (
          request.resource.data.completedBy is list
          && resource.data.completedBy is list
          && request.resource.data.completedBy.size() == resource.data.completedBy.size() + 1
          && request.auth.uid in request.resource.data.completedBy
          && !(request.auth.uid in resource.data.completedBy)
          && request.resource.data.passengers == resource.data.passengers
        )
        ||
        // Status Accepted/Completed allowed if reflects members
        (
          (request.resource.data.status == 'Accepted' || request.resource.data.status == 'Completed')
          && request.resource.data.passengers == resource.data.passengers
        )
      );

      // Only driver or shared-ride creator can delete
      allow delete: if request.auth != null && (
        resource.data.driverId == request.auth.uid
        || (resource.data.createdBy is string && resource.data.createdBy == request.auth.uid)
      );
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && resource.data.toUserId == request.auth.uid;
    }

    // --- Group Chats ---
    match /groupChats/{rideId} {
      // Only members of the ride can read/create inside group chat
      match /messages/{msgId} {
        allow read, create: if isRideMember(rideId);
      }
    }

    // --- Chats (for private chat flow) ---
    match /chats/{chatId} {
      allow create: if request.auth != null
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow read, update: if request.auth != null && (request.auth.uid in resource.data.participants);

      // Messages subcollection inside a chat
      match /messages/{msgId} {
        allow read: if request.auth != null
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow create: if request.auth != null
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants)
          && request.resource.data.senderId == request.auth.uid;
      }
    }

    // --- Society Feed ---
    match /feed/{feedId} {
      // Anyone logged in can read feed posts
      allow read: if request.auth != null;
      
      // Anyone logged in can create a post
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.likes is list
        && request.resource.data.comments is list;
      
      // Only post creator can update (for likes and comments)
      allow update: if request.auth != null;
      
      // Only post creator can delete their own post
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
