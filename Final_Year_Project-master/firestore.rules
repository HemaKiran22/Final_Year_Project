rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Users ---
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update: if request.auth != null && request.auth.uid == userId;
    }

    // --- Rides ---
    match /rides/{rideId} {
      allow read: if request.auth != null;

      // Post a ride: must be logged in and be the driver
      allow create: if request.auth != null
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.from is string
        && (request.resource.data.seats is int || request.resource.data.seats is number)
        && (request.resource.data.price is int || request.resource.data.price is number)
        && request.resource.data.community is string;

      // Update rules:
      // - Driver can update their ride
      // - Passengers can append themselves to passengers (join)
      allow update: if request.auth != null && (
          // Driver editing their ride
          resource.data.driverId == request.auth.uid
          // Passenger joining: only append self to passengers; do not change driver or price
          || (
            request.resource.data.driverId == resource.data.driverId
            && request.resource.data.price == resource.data.price
            && request.resource.data.from == resource.data.from
            && request.resource.data.seats == resource.data.seats
            && request.resource.data.destination == resource.data.destination
            && request.resource.data.date == resource.data.date
            && request.resource.data.time == resource.data.time
            && request.resource.data.community == resource.data.community
            && request.resource.data.passengers is list
            && resource.data.passengers is list
            && request.resource.data.passengers.size() == resource.data.passengers.size() + 1
            && request.resource.data.passengers.hasOnly(resource.data.passengers + [request.auth.uid])
          )
        );

      // Only driver can delete
      allow delete: if request.auth != null && resource.data.driverId == request.auth.uid;
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && resource.data.toUserId == request.auth.uid;
    }

    // --- Chats (for private chat flow) ---
    match /chats/{chatId} {
      allow create: if request.auth != null && request.resource.data.participants is list
        && request.resource.data.participants.hasOnly([request.auth.uid, request.resource.data.participants[1]]);
      allow read, update: if request.auth != null && resource.data.participants.hasAny([request.auth.uid]);

      // Messages subcollection inside a chat
      match /messages/{msgId} {
        allow create, read: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      }
    }

    // --- Society Feed ---
    match /feed/{feedId} {
      // Anyone logged in can read feed posts
      allow read: if request.auth != null;
      
      // Anyone logged in can create a post
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.likes is list
        && request.resource.data.comments is list;
      
      // Only post creator can update (for likes and comments)
      allow update: if request.auth != null;
      
      // Only post creator can delete their own post
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
